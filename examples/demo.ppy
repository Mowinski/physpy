# %% Physical constants and hydrostatic pressure (with `pint` units)
# Variables and imports marked with `export` are shared across cells.
# Writing `NUMBER [unit]` creates a physical quantity (`pint.Quantity`) with dimensional checking!
export import numpy as np
export const \rho_0 = 1000.0 [kg/m^3]  # water density (`const` prevents reassignment!)
export const g = 9.81 [m/s^2]          # standard gravity

h = 12.5 [m]                           # depth (cell-local variable)
p = (\rho_0 * g * h).to("kPa")
print(f"Hydrostatic pressure: {p:.2f}")

# %% Simple pendulum (uses exported `g` and `np`)
L = 2.0 [m]
export \omega_0 = np.sqrt(g / L)
export T = (2 * np.pi / \omega_0).to("s")
print(f"Angular frequency: {\omega_0:.3f}")
print(f"Oscillation period: {T:.2f}")

# %% Damped harmonic oscillator plot (`plot plt`)
import matplotlib.pyplot as plt

\gamma = 0.25 [1/s]                    # damping coefficient
t = np.linspace(0, 12, 400) * 1 [s]
\theta = np.exp(-\gamma * t) * np.cos(\omega_0 * t)

plt.figure(figsize=(6.5, 3.2))
plt.plot(t, \theta, label=r"$\theta(t) = e^{-\gamma t}\cos(\omega_0 t)$")
plt.axhline(0, color="gray", linewidth=0.8, linestyle="--")
plt.xlabel("t [s]")
plt.ylabel("θ [rad]")
plt.title("Damped Pendulum")
plt.legend()
plt.grid(True, alpha=0.3)

plot plt
