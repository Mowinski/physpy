{
  "name": "physpy-editor",
  "version": "0.1.1",
  "description": "PhysPy: Python editor with physics notation (Tauri + CodeMirror)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
